# Frontend environment template. Copy to .env.local and fill in real values.

# Backend API base URL (FastAPI). lib/api.ts falls back to this if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Clerk — get these from your Clerk dashboard (Frontend API keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect config (App Router).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
